# ==============================================================================
# Zaika QR Dine Platform - Backend Environment Configuration
# ==============================================================================

# ----------------- SECURITY & JWT -----------------
# Secret key used for signing Admin JWT tokens and internal HMAC hashes
SECRET_KEY=zaika-super-secret-jwt-key-2026

# ----------------- DATABASE -----------------
# Custom path to SQLite database (defaults to 'zaika.db' in backend root)
# DB_PATH=/path/to/custom_zaika.db

# ----------------- RAZORPAY PAYMENT GATEWAY (Optional) -----------------
# Leave blank to enable test/demo payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ----------------- SMS OTP GATEWAYS (Optional) -----------------
# Fast2SMS Provider (India)
FAST2SMS_API_KEY=

# Twilio SMS Provider (International)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 Provider
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
